{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "sdk-58"
      },
      "node": "22.14.0"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "image": "sdk-58"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "ios": {
        "image": "sdk-58"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.14.0",
      "ios": {
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "/path/to/your/google-play-service-account.json",
        "track": "production"
      },
      "ios": {
        "ascAppId": "0000000000",
        "ascApiKeyPath": "/path/to/your/AuthKey_XXXXXXXXXX.p8",
        "ascApiKeyId": "XXXXXXXXXX",
        "ascApiKeyIssuerId": "00000000-0000-0000-0000-000000000000",
        "appleTeamId": "XXXXXXXXXX"
      }
    }
  }
}
