# Copy to .env and fill in. Both values below are REQUIRED — `docker compose up`
# fails fast without them, and the server refuses to boot on a weak signing key.
#
#   BALU_SECRET_KEY=$(openssl rand -hex 32)
#   BALU_DB_PASSWORD=$(openssl rand -hex 16)

BALU_SECRET_KEY=
BALU_DB_PASSWORD=

# Optional
# BALU_PORT=8080
# Closing registration closes the only route to a new account — invites add
# existing users to a workspace, they do not create one. Re-open it briefly to
# onboard someone, rather than expecting an invite link to do it.
# BALU_ALLOW_REGISTRATION=false
# Comma-separated origins; empty (default) = same-origin only.
# BALU_CORS_ORIGINS=
# Local development escape hatch: skips the SECRET_KEY strength check.
# BALU_DEV=1
# Number of trusted reverse proxies in front of Balu. 0 (default) ignores
# X-Forwarded-For entirely — set it only if a proxy really does set that header,
# and match your actual chain depth (it is counted from the right).
# BALU_TRUSTED_PROXY_HOPS=1

# Remote MCP server: lets Claude Code (and other MCP clients) manage tasks through
# a per-user key from Settings → Claude / MCP. Off by default, because the key is a
# non-expiring bearer token with full access to that user's workspaces.
# BALU_MCP_ENABLED=true

# Notification transports (all optional)
# BALU_SMTP_HOST=
# BALU_SMTP_PORT=587
# BALU_SMTP_USER=
# BALU_SMTP_PASSWORD=
# BALU_SMTP_FROM=
# BALU_TELEGRAM_BOT_TOKEN=
